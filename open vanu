@echo off
setlocal
rem Vanu launcher (buyer build).
set "VANU=%~dp0"
set "PY=%VANU%bin\python-3.14.7-embed-amd64\pythonw.exe"
if not exist "%PY%" (
  echo Vanu is missing files. Extract the whole zip, then run this again.
  pause
  exit /b 1
)
for %%D in (config jobs live logs outputs temp) do if not exist "%VANU%%%D" mkdir "%VANU%%%D"
set "DLSS5_WINDOWLESS=1"
cd /d "%VANU%"
start "" "%PY%" "%VANU%app.pyc"
endlocal
